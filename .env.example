# Set both values in your local .env and in Vercel Project Settings → Environment Variables.
# Choose a password to share with approved readers. Keep the signing secret private and random.
PROJECTS_PASSWORD=replace-with-your-shared-password
PROJECT_ACCESS_SECRET=replace-with-a-long-random-secret

# Firebase client configuration for Google sign-in and cloud game saves.
# These PUBLIC_FIREBASE values are client config, not server-side secrets.
PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
