---
import { CROPS } from '../lib/min-farming.js';
---
<section class="mini-farm-panel" id="mini-farm-panel" hidden aria-labelledby="farm-title"><header><div><span class="game-kicker">A LITTLE PATCH OF YOUR OWN</span><h2 id="farm-title" tabindex="-1">Mini’s Farm</h2></div><button type="button" data-world-go="market">Go to Berry Market →</button></header><p>Plant a seed, water it once, then come back to harvest. Your six plots keep growing while you explore.</p><div class="farm-stats"><span>◉ <strong data-farm-coins>100</strong> farm coins</span><span><strong data-farm-harvested>0</strong> crops harvested</span><span><strong data-farm-sold>0</strong> crops sold</span></div><fieldset class="farm-seed-choices"><legend>Choose a seed</legend>{Object.entries(CROPS).map(([id,crop],i)=><label><input type="radio" name="farm-seed" value={id} checked={i===0}/><span>{crop.icon} {crop.name}<small><b data-farm-seeds={id}>0</b> seeds · {crop.growMs/1000}s growth</small></span></label>)}</fieldset><div class="farm-plots" id="farm-plots">{Array.from({length:6},(_,index)=><button type="button" data-farm-plot={index}><svg viewBox="0 0 64 48" aria-hidden="true" shape-rendering="crispEdges"><path fill="#9e7251" d="M4 18h56v26H4z"/><path fill="#bd9166" d="M4 18h56v4H4zM10 28h44v2H10zm0 8h44v2H10z"/><g class="farm-crop-art"></g></svg><strong>Plot {index+1}</strong><span class="farm-plot-state">Empty · plant a seed</span></button>)}</div><p id="farm-message" class="farm-message" role="status">Welcome, farmer Mini! You start with 100 farm coins and 10 seeds.</p><p class="cafe-tracking-note">Click an empty plot to plant your selected seed. Click a growing crop to water once; click a ready crop to harvest. Watering shortens growth by 25% and adds one crop.</p></section>
<section class="mini-market-panel" id="mini-market-panel" hidden aria-labelledby="market-title"><header><div><span class="game-kicker">BRAM’S FRESH PRODUCE STALL</span><h2 id="market-title" tabindex="-1">Berry Market</h2></div><button type="button" data-world-go="farm">Back to my farm →</button></header><p>Turn your harvest into farm coins, then stock up for the next planting.</p><div class="farm-stats"><span>◉ <strong data-farm-coins>100</strong> farm coins</span><span><strong data-farm-sold>0</strong> crops sold</span></div><div class="market-goods">{Object.entries(CROPS).map(([id,crop])=><section><span class="market-crop-icon" aria-hidden="true">{crop.icon}</span><h3>{crop.name}</h3><p><strong data-farm-produce={id}>0</strong> in your basket</p><button type="button" data-market-sell={id}>Sell harvest · {crop.sellPrice} coins each</button><button type="button" data-market-buy={id}>Buy seed · {crop.seedPrice} coins</button><small><span data-farm-seeds={id}>0</span> seeds in your pouch</small></section>)}</div><p class="farm-message" id="market-message" role="status">Bram: Welcome! Bring me something fresh from your farm.</p><p class="cafe-tracking-note">Farm coins are game currency. Sell harvest sells all held units of that crop; Buy seed buys one seed. Crops, seeds and coins save with your player profile.</p></section>
<script>
  import { initFarming } from '../lib/min-farm-ui.js';
  initFarming();
</script>
