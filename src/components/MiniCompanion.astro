---
import MiniAvatar from './MiniAvatar.astro';
import { EMOTES } from '../lib/min-emotes.js';
---
<div class="pixel-walker-track">
  <div class="pixel-walker" id="mini-walker">
    <button class="min-companion-trigger" id="min-companion-trigger" type="button" aria-label="Open Min’s activities" aria-expanded="false" aria-controls="min-companion-menu"><MiniAvatar /><span class="min-companion-hint">Hi! Click me</span></button>
    <span class="min-reward-bubble" id="min-reward-bubble" aria-live="polite"></span>
  </div>
</div>
<section class="min-companion-menu" id="min-companion-menu" role="dialog" aria-label="Min’s activities" hidden>
  <header><div><span>YOUR LITTLE COMPANION</span><h2>A moment with Min</h2></div><button type="button" id="min-menu-close" aria-label="Close Min’s activities">×</button></header>
  <div class="min-points-row"><span>✦ <strong data-min-points>0</strong> points</span><small data-min-level>Level 1</small></div>
  <p class="min-speech" id="min-speech" aria-live="polite">A coffee, a bowl, or a little studying?</p>
  <div class="min-emote-options" role="group" aria-label="Mini emotes">{Object.entries(EMOTES).map(([kind, emote]) => <button type="button" data-min-emote={kind}><span aria-hidden="true">{emote.icon}</span>{emote.label}</button>)}</div>
  <div class="min-activity-options">
    <button type="button" data-min-activity="coffee"><span aria-hidden="true">☕</span><span>Drink coffee<small>8 seconds · +10 points</small></span><span aria-hidden="true">↗</span></button>
    <button type="button" data-min-activity="tuna"><span aria-hidden="true">🍚</span><span>Eat a tuna bowl<small>10 seconds · +15 points</small></span><span aria-hidden="true">↗</span></button>
    <button type="button" data-min-activity="study"><span aria-hidden="true">📖</span><span>Study together<small>15 seconds · +25 points</small></span><span aria-hidden="true">↗</span></button>
  </div>
  <div class="min-activity-progress" id="min-activity-progress" hidden><progress id="min-activity-meter" max="100" value="0" aria-label="Activity progress"></progress><span id="min-activity-countdown"></span></div>
  <a class="min-wardrobe-link" href="/game">Style Min & explore the game →</a>
  <small class="min-save-caption" id="min-save-caption">Look & progress saved on this device</small>
</section>
<script>
  import { initMini } from '../lib/min-companion.js';
  initMini();
</script>
