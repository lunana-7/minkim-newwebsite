---
import MiniAvatar from './MiniAvatar.astro';
import { EMOTES } from '../lib/min-emotes.js';
---
<section class="mini-adventure" aria-labelledby="adventure-title">
  <header class="adventure-heading"><div><span class="game-kicker">MINI’S MAPLE MEADOW</span><h2 id="adventure-title">A little adventure</h2></div><button class="game-button music-button" type="button" data-adventure-music>♫ Play cozy BGM</button></header>
  <div class="adventure-hud"><span>✦ <strong data-min-points>0</strong> points</span><span><strong id="adventure-stars">0</strong> / 16 stars</span><span id="adventure-quest">Pippin’s wish · 0 / 6</span></div>
  <div class="adventure-viewport"><canvas id="adventure-canvas" width="960" height="480" tabindex="0" aria-label="Mini’s side-scrolling meadow adventure" aria-describedby="adventure-instructions"></canvas><div class="adventure-overlay" id="adventure-overlay"><span class="adventure-stamp" aria-hidden="true">✦</span><h3>Ready, Mini?</h3><p>Jump between platforms, gather stars, and bring six to Pippin for a sweet surprise.</p><button id="adventure-play" class="game-button save-button" type="button">Enter the meadow →</button></div></div>
  <div class="adventure-toolbar"><div class="adventure-touch-controls" role="group" aria-label="Movement controls"><button type="button" data-adventure-hold="left" aria-label="Move left">←</button><button type="button" data-adventure-hold="right" aria-label="Move right">→</button><button type="button" id="adventure-jump" aria-label="Jump">↑ Jump</button></div><div><button class="game-button" id="adventure-map-toggle" type="button" aria-expanded="false" aria-controls="adventure-world-map">Map ♧</button><button class="game-button" id="adventure-cafe" type="button">Visit café ☕</button><button class="game-button" id="adventure-talk" type="button">Talk / E</button><button class="game-button" id="adventure-pause" type="button">Pause</button></div></div>
  <div id="adventure-world-map" class="adventure-world-map" hidden>
    <h3>Maple Meadow map</h3><p>Choose a destination to travel there. The berry marker shows where Mini is.</p>
    <svg viewBox="0 0 3600 240" role="img" aria-label="Meadow route from the starting meadow to Maple Cup Café, Pippin and the cloud gate"><path d="M90 130H3485" stroke="#a5be8d" stroke-width="26" stroke-dasharray="35 20"/><g fill="#f4ddb3" stroke="#977654" stroke-width="8"><rect x="50" y="85" width="80" height="80"/><rect x="610" y="85" width="80" height="80"/><rect x="1200" y="85" width="80" height="80"/><rect x="3445" y="85" width="80" height="80"/></g><g fill="#645340" font-family="Nunito,sans-serif" font-size="65" text-anchor="middle"><text x="90" y="230">Start</text><text x="650" y="230">Café</text><text x="1240" y="230">Pippin</text><text x="3380" y="230">Gate</text></g><g id="adventure-map-marker" transform="translate(90 55)"><path fill="#c77994" d="M-24-22h48v30L0 36-24 8z"/><rect fill="#fff2df" x="-9" y="-12" width="18" height="18"/></g></svg>
    <p id="adventure-map-location" role="status">Mini is at the starting meadow.</p><div class="adventure-map-destinations"><button type="button" data-adventure-travel="90">Starting meadow</button><button type="button" data-adventure-travel="650">Maple Cup Café ☕</button><button type="button" data-adventure-travel="1240">Pippin’s tree</button><button type="button" data-adventure-travel="3370">Cloud gate</button></div>
  </div>
  <p id="adventure-instructions" class="adventure-instructions">Move: ← → or A / D · Jump: Space / ↑ · Talk / enter café: E · Click Mini for an emote. On touchscreens, use the buttons.</p>
  <div class="adventure-emotes" role="group" aria-label="Adventure emotes">{Object.entries(EMOTES).map(([kind, emote]) => <button type="button" data-adventure-emote={kind}><span aria-hidden="true">{emote.icon}</span>{emote.label}</button>)}</div>
  <p id="adventure-message" class="adventure-message" role="status" aria-live="polite">A peaceful meadow, a pocketful of stars, and a friend to meet.</p>
  <p class="adventure-save-note">Outfit, stars, quest completion, and your position are saved with your player profile. Guest progress is saved in this browser.</p>
  <a class="adventure-source-link" href="/game-source/mini-adventure-source.zip" download>Download game source · MIT →</a>
  <div class="adventure-character-source" aria-hidden="true"><MiniAvatar variant="adventure" /></div>
</section>
<script>
  import { initAdventure } from '../lib/min-adventure.js';
  initAdventure();
</script>
