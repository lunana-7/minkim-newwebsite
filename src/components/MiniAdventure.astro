---
import MiniAvatar from './MiniAvatar.astro';
import MiniCafe from './MiniCafe.astro';
import MiniFarm from './MiniFarm.astro';
import MiniKitchen from './MiniKitchen.astro';
import { WORLD_LINKS } from '../lib/min-portals.js';
import { EMOTES } from '../lib/min-emotes.js';
import { RESOURCES } from '../lib/min-resource-data.js';
import { GAME_MAP_LOCATIONS, WORLDS } from '../lib/min-worlds.js';
---
<section class="mini-adventure" aria-labelledby="adventure-title">
  <header class="adventure-heading"><div><span class="game-kicker">MINI’S COZY WORLDS</span><h2 id="adventure-title">A little adventure</h2></div><div class="adventure-heading-actions"><button class="game-button music-button" type="button" data-adventure-music>♫ Play cozy BGM</button><button class="game-button adventure-expand-button" id="adventure-expand" type="button" aria-label="Expand game screen" aria-pressed="false">⛶ Full screen</button></div></header>
  <div class="adventure-hud"><span>✦ <strong data-min-points>0</strong> points</span><span><strong id="adventure-stars">0</strong> / 16 stars</span><span id="adventure-quest">Pippin’s wish · 0 / 6</span></div>
  <nav class="adventure-world-tabs" aria-label="Travel between worlds">{Object.entries(WORLDS).map(([id,world])=><button type="button" data-world-go={id} aria-pressed="false"><span aria-hidden="true">{world.icon}</span>{world.name}</button>)}</nav>
  <div class="adventure-viewport"><span id="adventure-key-status" class="adventure-key-status" aria-live="off">Enter · start</span><canvas id="adventure-canvas" width="960" height="480" tabindex="0" aria-label="Mini’s side-scrolling world adventure" aria-describedby="adventure-instructions"></canvas><div class="adventure-overlay" id="adventure-overlay"><span class="adventure-stamp" aria-hidden="true">✦</span><h3>Ready, Mini?</h3><p>Explore seven worlds, gather resources and stars, and meet the locals. Open Map to choose your next adventure.</p><button id="adventure-play" class="game-button save-button" type="button">Enter the world →</button></div>
    <section id="mini-interaction-screen" class="mini-interaction-screen" hidden aria-labelledby="mini-interaction-title">
      <header class="mini-interaction-bar"><div><span>MINI’S WORLD · IN-GAME</span><h2 id="mini-interaction-title">A little visit</h2></div><button type="button" id="mini-interaction-expand" aria-label="Expand activity window" aria-pressed="false">↗</button><button type="button" id="mini-interaction-close" aria-label="Return to the world">← World</button></header>
      <div id="mini-interaction-content" class="mini-interaction-content"><MiniCafe /><MiniFarm /><MiniKitchen /></div>
    </section>
  </div>
  <div class="adventure-toolbar"><div class="adventure-touch-controls" role="group" aria-label="Movement controls"><button type="button" data-adventure-hold="left" aria-label="Move left">←</button><button type="button" data-adventure-hold="right" aria-label="Move right">→</button><button type="button" id="adventure-jump" aria-label="Jump">↑ Jump</button><button type="button" id="adventure-drop" aria-label="Drop through a platform">↓ Drop</button></div><div><button class="game-button" id="adventure-map-toggle" type="button" aria-expanded="false" aria-controls="adventure-world-map">Map ♧</button><button class="game-button" data-kitchen-open="icecream" type="button">Ice cream shop 🍦</button><button class="game-button" data-kitchen-open="bakery" type="button">Bakery 🍰</button><button class="game-button" data-farm-visit="farm" type="button">My farm ♧</button><button class="game-button" data-farm-visit="market" type="button">Market ◉</button><button class="game-button" id="adventure-cafe" type="button">Visit café ☕</button><button class="game-button" id="adventure-portal" type="button" disabled>↑ Enter portal</button><button class="game-button" id="adventure-gather" type="button">Gather / G</button><button class="game-button" id="adventure-talk" type="button">Talk / Enter</button><button class="game-button" id="adventure-pause" type="button">Pause</button></div></div>
  <div id="adventure-world-map" class="adventure-world-map" hidden>
    <h3 id="adventure-map-title">Maple Meadow map</h3><p>Choose a destination to travel there. Glowing paths connect the worlds. Stand in front of a portal and press ↑ to cross. The berry marker shows Mini on the local trail.</p>
    <div class="adventure-map-layout"><div class="adventure-map-art">    <div class="mini-world-atlas"><img src="/game-art/world-map.webp" alt="Pixel world with a meadow village, timber forest, magical secret forest, harbor, desert oasis, farm and market." width="1448" height="1086" loading="lazy" /><svg class="world-portal-paths" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">{WORLD_LINKS.map(([from,to])=><line x1={GAME_MAP_LOCATIONS[from].x} y1={GAME_MAP_LOCATIONS[from].y} x2={GAME_MAP_LOCATIONS[to].x} y2={GAME_MAP_LOCATIONS[to].y} />)}</svg>{Object.entries(GAME_MAP_LOCATIONS).map(([id,stop])=><button type="button" data-world-go={id} style={`--map-x:${stop.x}%;--map-y:${stop.y}%`}><span aria-hidden="true">{WORLDS[id].icon}</span>{stop.label}</button>)}</div></div><div class="adventure-map-side"><h4>Choose your next world</h4><p>Click a location on the map. In the field, use ↑ to enter a portal.</p><div class="adventure-map-destinations"><button type="button" data-kitchen-open="icecream">Cloud Scoop · Get an ice cream job 🍦</button><button type="button" data-kitchen-open="bakery">Honeycrumb · Become a cake baker 🍰</button></div><details class="adventure-map-details"><summary>Local trail & nearby stops ▾</summary><h4>Local trail</h4><svg id="adventure-route-diagram" viewBox="0 0 3600 240" role="img" aria-label="Meadow route from the starting meadow to Maple Cup Café, Pippin and the cloud gate"><path d="M90 130H3485" stroke="#a5be8d" stroke-width="26" stroke-dasharray="35 20"/><g fill="#f4ddb3" stroke="#977654" stroke-width="8"><rect x="50" y="85" width="80" height="80"/><rect x="610" y="85" width="80" height="80"/><rect x="1200" y="85" width="80" height="80"/><rect x="3445" y="85" width="80" height="80"/></g><g fill="#645340" font-family="Nunito,sans-serif" font-size="65" text-anchor="middle"><text x="90" y="230">Start</text><text x="650" y="230">Café</text><text x="1240" y="230">Pippin</text><text x="3380" y="230">Gate</text></g><g id="adventure-map-marker" transform="translate(90 55)"><path fill="#c77994" d="M-24-22h48v30L0 36-24 8z"/><rect fill="#fff2df" x="-9" y="-12" width="18" height="18"/></g></svg>
    <p id="adventure-map-location" role="status">Mini is at the starting meadow.</p><div class="adventure-map-destinations" id="adventure-meadow-stops"><button type="button" data-adventure-travel="90">Starting meadow</button><button type="button" data-adventure-travel="650">Maple Cup Café ☕</button><button type="button" data-adventure-travel="1240">Pippin’s tree</button><button type="button" data-adventure-travel="3245">Market portal</button></div>
    <h4>World portals</h4><div id="adventure-portal-directory" class="adventure-npc-directory"></div><p class="adventure-portal-note">Each portal has a matching return portal. Your outfit and progress travel with you.</p><h4>Gathering stops</h4><div id="adventure-resource-directory" class="adventure-npc-directory"></div><h4>Meet the locals</h4><div id="adventure-npc-directory" class="adventure-npc-directory"></div>
</details></div></div>
  </div>
  <details class="gathering-pouch"><summary>My resource pouch · <strong data-gather-total>0</strong> gathered</summary><div>{Object.entries(RESOURCES).map(([id,item])=><span><img src={`/game-art/items/resource-${id}.png`} alt="" /> {item.name} <strong data-gather-count={id}>0</strong></span>)}</div><p>Walk close to a resource and press G or click it. Tools are included. Each gathering spot regrows in 30 seconds. Sell your resources at Berry Market.</p></details><section class="adventure-npc-dialog" id="adventure-npc-dialog" hidden aria-labelledby="adventure-npc-name"><div class="npc-dialogue-portrait"><img id="adventure-npc-portrait" src="/mini/looks/bob-meadow.png" alt="" width="192" height="192"/></div><div class="npc-dialogue-copy"><header><div><span id="adventure-npc-role" class="game-kicker"></span><h3 id="adventure-npc-name"></h3></div><button id="adventure-npc-close" type="button" aria-label="Close conversation">×</button></header><p id="adventure-npc-line" aria-live="off"></p><footer><small id="adventure-npc-page"></small><button id="adventure-npc-back" type="button" aria-label="Previous dialogue">←</button><button id="adventure-npc-action" type="button">Next →</button></footer></div></section>
  <p id="adventure-instructions" class="adventure-instructions">Move: ← → or A / D · Jump: Space / ↑ · Drop through a platform: ↓ / S · Talk / interact: Enter · Enter portal: ↑ · Gather: G · Stand in front of a glowing portal and press ↑ to change worlds. Climb the stepping platforms to reach the high trail. Click Mini for an emote. On touchscreens, use the buttons.</p>
  <div class="adventure-emotes" role="group" aria-label="Adventure emotes">{Object.entries(EMOTES).map(([kind, emote]) => <button type="button" data-adventure-emote={kind}><img src={emote.asset} alt="" width="28" height="28" loading="lazy" />{emote.label}</button>)}</div>
  <p id="adventure-message" class="adventure-message" role="status" aria-live="polite">A peaceful meadow, a pocketful of stars, and a friend to meet.</p>
  <p class="adventure-save-note">Outfit, pet companions, stars, quests, gathered resources, crops, seeds, farm coins, dessert careers and your position are saved with your player profile. Guest progress is saved in this browser.</p>
  <a class="adventure-source-link" href="/game-source/mini-adventure-source.zip" download>Download game source · MIT →</a>
  <div class="adventure-character-source" aria-hidden="true"><MiniAvatar variant="adventure" /></div>
</section>
<script>
  import { initAdventure } from '../lib/min-adventure.js';
  import { initGatheringPouch } from '../lib/min-gathering.js';
  initAdventure();
  initGatheringPouch();
</script>
