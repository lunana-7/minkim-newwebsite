---
const topics=[{id:'plan',title:'Interview preparation',caption:'Research, role mapping & questions'},{id:'personal-statement',title:'A personal note',caption:'Motivation, learning & contribution'}];
---
<section class="section wrap preparation-hub" id="preparation" aria-labelledby="preparation-title">
 <header class="section-head"><div><h2 id="preparation-title">How I’m preparing.<br/>Why this work matters to me.</h2></div></header>
 <div class="preparation-menu" role="tablist" aria-label="Explore my preparation and motivation">{topics.map((topic,i)=><button type="button" role="tab" id={`preparation-tab-${topic.id}`} aria-controls={`preparation-panel-${topic.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-preparation-topic={topic.id}><span>0{i+1}</span><strong>{topic.title}</strong><small>{topic.caption}</small></button>)}</div>
 {topics.map((topic,i)=><div class="preparation-panel" id={`preparation-panel-${topic.id}`} role="tabpanel" aria-labelledby={`preparation-tab-${topic.id}`} hidden={i!==0}><slot name={topic.id} /></div>)}
</section>
<script>
 const hub=document.querySelector<HTMLElement>('.preparation-hub');
 if(hub){
  const tabs=Array.from(hub.querySelectorAll<HTMLButtonElement>('[data-preparation-topic]'));
  const activate=(id:string,focus=false)=>tabs.forEach(tab=>{const selected=tab.dataset.preparationTopic===id;tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;const panel=document.getElementById(`preparation-panel-${tab.dataset.preparationTopic}`);if(panel)panel.hidden=!selected;if(selected&&focus)tab.focus();});
  tabs.forEach((tab,i)=>{
   tab.addEventListener('click',()=>activate(tab.dataset.preparationTopic!));
   tab.addEventListener('keydown',event=>{let next=i;if(event.key==='ArrowRight')next=(i+1)%tabs.length;else if(event.key==='ArrowLeft')next=(i-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(tabs[next].dataset.preparationTopic!,true);});
  });
  const reveal=(id:string)=>{const target=document.getElementById(id);const panel=target?.closest<HTMLElement>('.preparation-panel');if(panel)activate(panel.id.replace('preparation-panel-',''));return panel?target:null;};
  const openHash=()=>{const target=reveal(decodeURIComponent(location.hash.slice(1)));if(target)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));};
  window.addEventListener('hashchange',openHash);openHash();
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link=>link.addEventListener('click',()=>reveal(link.hash.slice(1))));
 }
</script>
<style>
 .preparation-menu{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:24px 0 0;}
 .preparation-menu button{font:inherit;text-align:left;border:1px solid #c8dfe5;border-radius:10px;padding:16px;background:#f1f8fa;color:#214f5b;cursor:pointer;}
 .preparation-menu span{display:block;font-size:11px;margin-bottom:8px;}
 .preparation-menu strong{display:block;font-size:16px;line-height:1.3;}
 .preparation-menu small{display:block;font-size:12px;line-height:1.5;margin-top:6px;}
 .preparation-menu button[aria-selected=true]{background:#214f5b;color:#fff;border-color:#214f5b;}
 .preparation-menu button:focus-visible{outline:2px solid #258ca0;outline-offset:3px;}
 .preparation-panel{margin-top:18px;padding:24px;border:1px solid #c8dfe5;border-radius:12px;}
 .preparation-panel[hidden]{display:none;}
 .preparation-panel :global(>section){width:100%;max-width:none;margin:0;padding:0;}
 .preparation-panel :global(h2){font-size:clamp(25px,3vw,34px);}
 @media(max-width:760px){.preparation-menu{grid-template-columns:1fr 1fr;}.preparation-menu button{padding:12px;}.preparation-panel{padding:16px;}}
</style>
