---
import { stages } from '../../data/handshake-business-stages';
---
<section class="section wrap business-understanding" id="handshake-business">
 <div class="section-head"><div><h2>How Handshake works.</h2></div></div>
 <p class="business-role-summary">Handshake helps AI labs <mark>run human-data projects</mark> by bringing in contributors, guiding their work and <mark>managing quality and delivery</mark> for AI training and evaluation.</p>
 <ol class="business-overview" aria-label="From lab needs to useful human judgment">{stages.map(([title,description],i)=><li><span>0{i+1}</span><h3>{title}</h3><p>{description}</p></li>)}</ol>
 <p class="business-overview-note">Based on Handshake’s AI Trainer guide and the Safety SPA job description.</p>
</section>
<style>
 .business-overview{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));list-style:none;padding:0;margin:20px 0 14px;gap:3px;}
 .business-overview li{background:#edf7f9;padding:20px 25px 20px 18px;clip-path:polygon(0 0,calc(100% - 14px) 0,100% 50%,calc(100% - 14px) 100%,0 100%);}
 .business-overview span{font-size:11px;letter-spacing:.08em;}
 .business-overview h3{font-size:19px;line-height:1.3;margin:12px 0 8px;color:inherit;}
 .business-overview p{font-size:13px;line-height:1.5;margin:0;color:inherit;}
 .business-overview-note{font-size:12px;color:#55727d;}
 .business-role-summary{font-size:18px;line-height:1.65;color:#214f5b;margin:16px 0 24px;max-width:1100px;}
 .business-role-summary strong{font-weight:650;}
 .business-collaboration-link{display:inline-block;font-size:14px;margin-top:8px;}
 @media(max-width:760px){.business-overview{grid-template-columns:1fr;gap:8px;}.business-overview li{padding:14px 24px 14px 16px;}.business-overview h3{display:inline;margin:0 0 0 10px;}.business-overview p{margin-top:6px;}}
</style>
