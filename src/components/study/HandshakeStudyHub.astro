---
import HandshakeTechnicalConnections from './HandshakeTechnicalConnections.astro';
import HandshakeTrainerTakeaways from './HandshakeTrainerTakeaways.astro';
import HandshakeHumanData from './HandshakeHumanData.astro';
import HandshakeStudyLibrary from './HandshakeStudyLibrary.astro';
import HandshakeReadingLibrary from './HandshakeReadingLibrary.astro';
const topics = [
 {id:'trainer-takeaways',title:'AI Trainer work',caption:'Handshake’s contributor model'},
 {id:'human-data',title:'Human data developments',caption:'Research & operational takeaways'},
 {id:'workflow-concepts',title:'Workflow concepts',caption:'Terms, examples & practice'},
 {id:'readings',title:'Reading notes',caption:'Sources, questions & application'},
 {id:'technical-connections',title:'Technical connections',caption:'Post-training & continuous evaluation'}
];
---
<section class="section wrap study-hub" id="study-library" aria-labelledby="study-hub-title">
 <header class="section-head"><div><h2 id="study-hub-title">How I’m studying human data.</h2></div></header>
 <div class="study-hub-menu" role="tablist" aria-label="Explore my study library">
  {topics.map((topic,i)=><button type="button" role="tab" id={`study-tab-${topic.id}`} aria-controls={`study-panel-${topic.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-study-topic={topic.id}><span>0{i+1}</span><strong>{topic.title}</strong><small>{topic.caption}</small></button>)}
 </div>
 <div class="study-hub-panel" id="study-panel-trainer-takeaways" role="tabpanel" aria-labelledby="study-tab-trainer-takeaways"><HandshakeTrainerTakeaways /></div>
 <div class="study-hub-panel" id="study-panel-human-data" role="tabpanel" aria-labelledby="study-tab-human-data" hidden><HandshakeHumanData /></div>
 <div class="study-hub-panel" id="study-panel-workflow-concepts" role="tabpanel" aria-labelledby="study-tab-workflow-concepts" hidden><HandshakeStudyLibrary /></div>
 <div class="study-hub-panel" id="study-panel-readings" role="tabpanel" aria-labelledby="study-tab-readings" hidden><HandshakeReadingLibrary /></div>
 <div class="study-hub-panel" id="study-panel-technical-connections" role="tabpanel" aria-labelledby="study-tab-technical-connections" hidden><HandshakeTechnicalConnections /></div>
</section>
<script>
 const hub=document.querySelector<HTMLElement>('.study-hub');
 if(hub){
  const tabs=Array.from(hub.querySelectorAll<HTMLButtonElement>('[data-study-topic]'));
  const activate=(id:string,focus=false)=>{
   tabs.forEach(tab=>{const selected=tab.dataset.studyTopic===id;tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;const panel=document.getElementById(`study-panel-${tab.dataset.studyTopic}`);if(panel)panel.hidden=!selected;if(selected&&focus)tab.focus();});
  };
  tabs.forEach((tab,i)=>{
   tab.addEventListener('click',()=>activate(tab.dataset.studyTopic!));
   tab.addEventListener('keydown',event=>{let next=i;if(event.key==='ArrowRight')next=(i+1)%tabs.length;else if(event.key==='ArrowLeft')next=(i-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(tabs[next].dataset.studyTopic!,true);});
  });
  const openHash=()=>{const id=decodeURIComponent(location.hash.slice(1));const target=document.getElementById(id);const panel=target?.closest<HTMLElement>('.study-hub-panel');if(panel){activate(panel.id.replace('study-panel-',''));requestAnimationFrame(()=>target?.scrollIntoView({block:'start'}));}};
  window.addEventListener('hashchange',openHash);openHash();
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link=>link.addEventListener('click',()=>{const target=document.getElementById(link.hash.slice(1));const panel=target?.closest<HTMLElement>('.study-hub-panel');if(panel)activate(panel.id.replace('study-panel-',''));}));
 }
</script>
<style>
 .study-hub-menu{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:24px 0 0;}
 .study-hub-menu button{font:inherit;text-align:left;border:1px solid #c8dfe5;border-radius:10px;padding:16px;background:#f1f8fa;color:#214f5b;cursor:pointer;}
 .study-hub-menu span{display:block;font-size:11px;margin-bottom:8px;}
 .study-hub-menu strong{display:block;font-size:16px;line-height:1.3;}
 .study-hub-menu small{display:block;font-size:12px;line-height:1.5;margin-top:6px;}
 .study-hub-menu button[aria-selected=true]{background:#214f5b;color:#fff;border-color:#214f5b;}
 .study-hub-menu button:focus-visible{outline:2px solid #258ca0;outline-offset:3px;}
 .study-hub-panel{margin-top:18px;padding:24px;border:1px solid #c8dfe5;border-radius:12px;}
 .study-hub-panel[hidden]{display:none;}
 .study-hub-panel :global(>section){width:100%;max-width:none;margin:0;padding:0;border-top:0;}
 .study-hub-panel :global(h2){font-size:clamp(25px,3vw,34px);}
 .study-hub-panel :global(.business-facts){margin-top:0;}
 @media(max-width:760px){.study-hub-menu{grid-template-columns:1fr 1fr;}.study-hub-menu button{padding:12px;}.study-hub-panel{padding:16px;}}
 @media(max-width:400px){.study-hub-menu small{font-size:11px;}.study-hub-menu strong{font-size:14px;}}
</style>
