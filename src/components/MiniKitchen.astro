---
import MiniAvatar from './MiniAvatar.astro';
import { KITCHENS } from '../lib/min-kitchen-data.js';
---
<section class="mini-kitchen" id="mini-kitchen" hidden aria-labelledby="kitchen-title">
 <header><div><span class="game-kicker" id="kitchen-job-label">A LITTLE SWEET CAREER</span><h2 id="kitchen-title" tabindex="-1">Cloud Scoop Ice Cream</h2></div><button type="button" class="game-button" id="kitchen-close">Back to the world →</button></header>
 <nav class="kitchen-shop-tabs" aria-label="Choose a workplace">{Object.entries(KITCHENS).map(([id,k])=><button type="button" data-kitchen-open={id}>{k.icon} {k.name}</button>)}</nav>
 <div class="kitchen-career"><span id="kitchen-career"></span><span>◉ <strong data-farm-coins>100</strong> farm coins</span><button type="button" id="kitchen-hire" class="game-button save-button">Apply for the job →</button></div>
 <div class="kitchen-layout"><div class="kitchen-workbench"><canvas id="kitchen-canvas" width="640" height="360" aria-label="Inside the dessert shop, with Mini at the workbench and the dessert you are making"></canvas><div class="kitchen-mini" aria-hidden="true"><MiniAvatar variant="kitchen" /></div><p id="kitchen-visual-caption">Your first shift awaits.</p></div><div class="kitchen-controls">
  <aside class="kitchen-ticket"><span class="game-kicker">CUSTOMER ORDER</span><p id="kitchen-ticket">Apply to receive your first order.</p></aside>
  <ol class="kitchen-steps" id="kitchen-steps"></ol>
  <h3 id="kitchen-step-title">Welcome to your workplace</h3><p id="kitchen-step-help"></p>
  <div id="kitchen-choice-area"></div>
  <div class="kitchen-process" id="kitchen-process" hidden><label for="kitchen-temperature">Machine setting <strong id="kitchen-temperature-label"></strong></label><input id="kitchen-temperature" type="range"/><div class="kitchen-progress"><span id="kitchen-process-fill"></span></div><p id="kitchen-process-status"></p></div>
  <button id="kitchen-action" class="game-button save-button" type="button" hidden>Start an order →</button>
  <button id="kitchen-abandon" class="game-button" type="button" hidden>Discard this order</button>
  <p id="kitchen-message" role="status" aria-live="polite">Coco and Honey are looking for a helping hand.</p>
 </div></div>
 <p class="cafe-tracking-note">Ingredients and tools are supplied by the shop. Orders, career XP, wages and your current recipe save with your player profile. Cooking times are shortened for play. Guest progress saves in this browser.</p>
</section>
<script>import { initKitchen } from '../lib/min-kitchen.js';initKitchen();</script>
