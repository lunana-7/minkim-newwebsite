---
// Each decoration shares the logo’s viewBox, so it stays inside the badge.
const socials = [
  { name: 'GitHub', href: 'https://github.com/minkim', kind: 'cherry' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/datamin', kind: 'sprinkles' },
  { name: 'X', href: 'https://x.com/minkim', kind: 'cookie' },
];
const logos = [`<path d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>`, `<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V8.99h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.3ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V8.99h3.56v11.46ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>`, `<path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.24l-4.89-7.4L5.6 22H2.5l7.25-8.28L1.7 2h6.4l4.42 6.75L18.9 2Zm-1.1 18h1.73L7.18 3.89H5.32L17.8 20Z"/>`];
---
<ul class="footer-socials pixel-socials">
  {socials.map((social, index) => <li>
    <a class={`sweet-social sweet-social-${social.kind}`} href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} profile`}>
      <svg class="decorated-social-logo" width="36" height="36" viewBox="0 0 32 32" aria-hidden="true">
        {social.kind === 'cookie' && <g transform="translate(3 3) scale(2.2)" shape-rendering="crispEdges">
          <path fill="#d4a268" d="M4 1h4v1h2v2h1v4h-1v2H8v1H4v-1H2V9H1V4h1V2h2z" />
          <path fill="#b98551" d="M2 8h1v1h1v1h4V9h2V8h1v1h-1v1H8v1H4v-1H2z" />
          <path fill="#866043" d="M4 3h1v1H4zm4 1h1v1H8zM3 7h1v1H3zm4 2h1v1H7zm3-3h1v1h-1z" />
        </g>}
        <g fill="currentColor" transform={social.kind === 'cherry' ? 'translate(4 8) scale(.9)' : social.kind === 'sprinkles' ? 'translate(5 5) scale(.92)' : 'translate(8 8) scale(.67)'} set:html={logos[index]} />
        {social.kind === 'cherry' && <g transform="translate(18 1)" shape-rendering="crispEdges">
          <path fill="#54834e" d="M6 1h1v3H6zm1 1h3v1H7z" />
          <path fill="#c74047" d="M2 6h1V4h3v1h1v3H6v2H3V9H2z" />
          <path fill="#d94f50" d="M8 5h1V4h2v1h1v3h-1v2H9V9H8z" />
          <path fill="#f9b5ab" d="M3 5h1v1H3zm6 0h1v1H9z" />
        </g>}
        {social.kind === 'sprinkles' && <g shape-rendering="crispEdges">
          <path fill="#f4abb6" d="M9 6h3v1H9zm13 3h3v1h-3zm-8-3h1v3h-1z" />
          <path fill="#ffe1a0" d="M18 6h1v3h-1zm7 11h1v3h-1z" />
          <path fill="#e3efd3" d="M6 13h1v3H6zm16-1h3v1h-3z" />
        </g>}
      </svg>
    </a>
  </li>)}
</ul>
