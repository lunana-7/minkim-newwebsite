---
import Layout from '../layouts/Layout.astro';
import MiniAvatar from '../components/MiniAvatar.astro';
import { ROOM_ITEMS } from '../lib/min-room-data.js';
---
<Layout title="Mini’s Room & Guestbook | Min’s World" activeNav="room" description="Make yourself at home in Mini’s dessert-themed pixel room. Move Mini, rearrange the furniture, and leave a little note in the guestbook.">
 <header class="room-intro"><span class="case-study-kicker">A LITTLE HOME IN MIN’S WORLD</span><h1>Make yourself at home.</h1><p>A sweet little room, a tiny walk, and a note from you. ♡</p><a href="#guestbook">Leave a guestbook note ↓</a></header>
 <section class="mini-room" aria-labelledby="room-title"><header><div><span>WELCOME TO MY LITTLE ROOM</span><h2 id="room-title">Mini’s Dessert Room</h2></div><button type="button" id="room-edit" aria-pressed="false">Decorate my room ♧</button></header><div class="room-stage"><canvas id="room-canvas" width="960" height="600" tabindex="0" aria-label="Mini’s interactive dessert room" aria-describedby="room-instructions"></canvas><div class="room-avatar-source" aria-hidden="true"><MiniAvatar variant="room" /></div></div><div class="room-play-controls" aria-label="Room controls"><button type="button" data-room-move="left" aria-label="Move Mini left">←</button><button type="button" data-room-move="up" aria-label="Move Mini up">↑</button><button type="button" data-room-move="down" aria-label="Move Mini down">↓</button><button type="button" data-room-move="right" aria-label="Move Mini right">→</button><button type="button" id="room-wave">Say hello ♡</button><button type="button" data-room-activity="coffee">Coffee break</button><button type="button" data-room-activity="study">Read together</button></div><p id="room-instructions">Click an open patch of floor to walk there, or use arrow keys. Click Mini to say hello. Switch to Decorate to drag the furniture.</p><p id="room-status" role="status">Welcome! I’m glad you’re here. ♡</p></section>
 <section class="room-decorator" id="room-decorator" hidden aria-labelledby="room-decor-title"><header><h2 id="room-decor-title">A room of your own</h2><button id="room-done" type="button">Done decorating ✓</button></header><div class="room-decor-settings"><label>Room name<input id="room-name" type="text" maxlength="32" value="Mini’s Dessert Room"/></label><label>Room mood<select id="room-theme"><option value="strawberry">Strawberry afternoon</option><option value="mint">Mint morning</option><option value="lavender">Lavender daydream</option></select></label><label>Rug<select id="room-rug"><option value="strawberry">Strawberry cream</option><option value="mint">Mint cream</option><option value="lavender">Lavender cream</option><option value="none">No rug</option></select></label></div><div class="room-item-list" role="group" aria-label="Furniture">{ROOM_ITEMS.map(item=><button data-room-item={item.id} type="button" aria-pressed="false"><img src={`/room-art/${item.id}.png`} width="60" height="60" alt=""/><span>{item.name}</span></button>)}</div><div class="room-item-tools"><span id="room-selected">Select a piece of furniture</span><label><input id="room-item-visible" type="checkbox" checked/>Show selected piece</label><button data-room-nudge="left" aria-label="Move selected furniture left">←</button><button data-room-nudge="up" aria-label="Move selected furniture up">↑</button><button data-room-nudge="down" aria-label="Move selected furniture down">↓</button><button data-room-nudge="right" aria-label="Move selected furniture right">→</button></div><footer><button id="room-save" type="button">Save my room ♡</button><button id="room-reset" type="button">Restore dessert layout</button><p id="room-save-status" role="status">Your decor is saved in this browser.</p></footer></section>
 <section class="room-guestbook" id="guestbook" aria-labelledby="guestbook-title"><header><div><span class="case-study-kicker">A LITTLE NOTE, A LOVELY MEMORY</span><h2 id="guestbook-title">Guestbook</h2></div><button id="guestbook-refresh" type="button">Refresh notes ↻</button></header><p>Say hello, share a thought, or tell Mini what made you smile.</p><p id="guestbook-mode" class="guestbook-mode">Loading the guestbook…</p><button id="guestbook-login" type="button" hidden>Sign in with Google to leave a note</button><form id="guestbook-form"><label>Your name<input id="guestbook-name" name="name" type="text" maxlength="30" required autocomplete="nickname" placeholder="What should Mini call you?"/></label><label>Your note<textarea id="guestbook-message" name="message" maxlength="500" rows="4" required placeholder="Hi Min! I stopped by your little room…"></textarea></label><label class="guestbook-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><div class="guestbook-stamp-options" role="group" aria-label="Choose a note stamp"><button data-note-stamp="heart" type="button" aria-pressed="true">♡ Heart</button><button data-note-stamp="cake" type="button" aria-pressed="false">🍰 Cake</button><button data-note-stamp="coffee" type="button" aria-pressed="false">☕ Coffee</button><button data-note-stamp="star" type="button" aria-pressed="false">✦ Star</button></div><p class="guestbook-visibility" id="guestbook-visibility">Your name and note will be visible to visitors of this guestbook.</p><button id="guestbook-submit" type="submit">Leave a little note ♡</button><p id="guestbook-status" role="status" aria-live="polite"></p></form><div id="guestbook-notes" class="guestbook-notes"></div></section>
 <script>import { initRoom } from '../lib/min-room.js';import { initGuestbook } from '../lib/min-guestbook.js';initRoom();initGuestbook();</script>
</Layout>
