---
import Layout from '../layouts/Layout.astro';
import MiniAvatar from '../components/MiniAvatar.astro';
import { ROOM_ITEMS, ROOM_RUGS, ROOM_THEMES } from '../lib/min-room-data.js';
---
<Layout title="Mini’s Room & Guestbook | Min’s World" activeNav="room" description="Make yourself at home in Mini’s dessert-themed pixel room. Move Mini, rearrange the furniture, and leave a little note in the guestbook.">
 <header class="room-intro"><span class="case-study-kicker">A LITTLE HOME IN MIN’S WORLD</span><h1>Make yourself at home.</h1><p>A sweet little room, a tiny walk, and a note from you. ♡</p><a href="#guestbook">Leave a guestbook note ↓</a></header>
 <section class="mini-room" aria-labelledby="room-title"><header><div><span>WELCOME TO MY LITTLE ROOM</span><h2 id="room-title">Mini’s Dessert Room</h2></div><button type="button" id="room-edit" aria-pressed="false">Decorate my room ♧</button></header><div class="room-stage"><canvas id="room-canvas" width="960" height="600" tabindex="0" aria-label="Mini’s interactive dessert room" aria-describedby="room-instructions"></canvas><div class="room-avatar-source" aria-hidden="true"><MiniAvatar variant="room" /></div><div id="room-character-menu" class="room-character-menu" hidden aria-label="Mini actions"><strong>Mini wants to…</strong><button type="button" data-room-action="eat">Eat cake 🍰</button><button type="button" data-room-action="sit">Sit down ♡</button><button type="button" data-room-action="read">Read a book 📖</button><button type="button" data-room-action="tea">Sip tea 🍵</button><button type="button" data-room-action="pet">Play with pet 🐾</button><button type="button" id="room-menu-close">Close ×</button></div></div><div class="room-play-controls" aria-label="Room controls"><button type="button" data-room-move="left" aria-label="Move Mini left">←</button><button type="button" data-room-move="up" aria-label="Move Mini up">↑</button><button type="button" data-room-move="down" aria-label="Move Mini down">↓</button><button type="button" data-room-move="right" aria-label="Move Mini right">→</button><button type="button" id="room-wave">Say hello ♡</button><button type="button" data-room-action="eat">Eat cake 🍰</button><button type="button" data-room-action="sit">Sit down ♡</button><button type="button" data-room-action="read">Read a book 📖</button><button type="button" data-room-action="tea">Sip tea 🍵</button><button type="button" data-room-action="pet">Play with pet 🐾</button></div><p id="room-instructions">Click Mini to choose an action, or click furniture to let her walk over and use it. In Decorate, add furniture from any collection, select a placed piece, drag it, or remove it.</p><p id="room-status" role="status">Welcome! I’m glad you’re here. ♡</p></section>
 <section class="room-decorator" id="room-decorator" hidden aria-labelledby="room-decor-title"><header><div><h2 id="room-decor-title">A room of your own</h2><p>Add as many pieces as you like. Choose a room and mix furniture from any collection.</p></div><button id="room-done" type="button">Done decorating ✓</button></header><div class="room-decor-settings"><label>Room name<input id="room-name" type="text" maxlength="32" value="Mini’s Dessert Room"/></label><label>Room theme<select id="room-theme">{ROOM_THEMES.map(theme=><option value={theme.id}>{theme.name}</option>)}</select></label><label>Rug<select id="room-rug">{ROOM_RUGS.map(rug=><option value={rug.id}>{rug.name}</option>)}<option value="none">No rug</option></select></label></div><div class="room-theme-choices" role="group" aria-label="Choose a room background">{ROOM_THEMES.map(theme=><button type="button" data-room-theme-choice={theme.id} aria-pressed="false"><img src={theme.image} alt="" width="160" height="102" loading="lazy"/><span>{theme.name}</span></button>)}</div><h3>Rugs</h3><div class="room-rug-choices" role="group" aria-label="Choose a pixel art rug">{ROOM_RUGS.map(rug=><button type="button" data-room-rug-choice={rug.id} aria-pressed="false"><img src={rug.image} alt="" width="180" height="75" loading="lazy"/><span>{rug.name}</span></button>)}<button type="button" data-room-rug-choice="none" aria-pressed="false"><span class="room-rug-none" aria-hidden="true">✕</span><span>No rug</span></button></div><div class="room-catalog-heading"><div><h3>Furniture collections</h3><p>Choose a collection to browse; every piece works in every room.</p></div><span id="room-furniture-count"></span></div><div class="room-category-filters" role="group" aria-label="Filter furniture by theme"><button type="button" data-room-category="all" aria-pressed="true">All</button>{ROOM_THEMES.map(theme=><button type="button" data-room-category={theme.id} aria-pressed="false">{theme.name.split(' ')[0]}</button>)}</div><div class="room-item-list" role="group" aria-label="Add furniture">{ROOM_ITEMS.map(item=><button data-room-item={item.id} data-room-item-category={item.category} type="button"><img src={`/room-art/${item.id}.png`} width="60" height="60" alt=""/><span>{item.name}<small>+ Add another</small></span></button>)}</div><div class="room-placed-heading"><h3>Placed furniture</h3><p>Choose a piece in the room or below to move or remove it.</p></div><div id="room-placed-list" class="room-placed-list" role="group" aria-label="Placed furniture"></div><div class="room-item-tools"><span id="room-selected">Select a piece of furniture</span><button id="room-remove-item" type="button">Remove selected ×</button><button data-room-nudge="left" aria-label="Move selected furniture left">←</button><button data-room-nudge="up" aria-label="Move selected furniture up">↑</button><button data-room-nudge="down" aria-label="Move selected furniture down">↓</button><button data-room-nudge="right" aria-label="Move selected furniture right">→</button></div><footer><button id="room-save" type="button">Save my room ♡</button><button id="room-reset" type="button">Restore dessert layout</button><p id="room-save-status" role="status">Your decor is saved in this browser.</p></footer></section>
 <section class="room-guestbook" id="guestbook" aria-labelledby="guestbook-title"><header><div><span class="case-study-kicker">A LITTLE NOTE, A LOVELY MEMORY</span><h2 id="guestbook-title">Guestbook</h2></div><button id="guestbook-refresh" type="button">Refresh notes ↻</button></header><p>Say hello, share a thought, or tell Mini what made you smile.</p><p id="guestbook-mode" class="guestbook-mode">Loading the guestbook…</p><button id="guestbook-login" type="button" hidden>Sign in with Google to leave a note</button><form id="guestbook-form"><label>Your name<input id="guestbook-name" name="name" type="text" maxlength="30" required autocomplete="nickname" placeholder="What should Mini call you?"/></label><label>Your note<textarea id="guestbook-message" name="message" maxlength="500" rows="4" required placeholder="Hi Min! I stopped by your little room…"></textarea></label><label class="guestbook-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><div class="guestbook-stamp-options" role="group" aria-label="Choose a note stamp"><button data-note-stamp="heart" type="button" aria-pressed="true">♡ Heart</button><button data-note-stamp="cake" type="button" aria-pressed="false">🍰 Cake</button><button data-note-stamp="coffee" type="button" aria-pressed="false">☕ Coffee</button><button data-note-stamp="star" type="button" aria-pressed="false">✦ Star</button></div><p class="guestbook-visibility" id="guestbook-visibility">Your name and note will be visible to visitors of this guestbook.</p><button id="guestbook-submit" type="submit">Leave a little note ♡</button><p id="guestbook-status" role="status" aria-live="polite"></p></form><div id="guestbook-notes" class="guestbook-notes"></div></section>
 <script>import { initRoom } from '../lib/min-room.js';import { initGuestbook } from '../lib/min-guestbook.js';initRoom();initGuestbook();</script>
</Layout>
