---
import Layout from '../layouts/Layout.astro';
import MiniAvatar from '../components/MiniAvatar.astro';
import { aboutData } from '../posts.js';
---

<Layout title="About | Min Kim" activeNav="about">
  <div>
    <h1 class="page-title">About</h1>
    <header class="about-mini-profile">
      <div class="about-mini-scene">
        <span class="about-mini-speech">Hi, I’m Min! ♡</span>
        <button class="about-mini-trigger" type="button" data-min-open-menu aria-label="Say hello to Mini and open her activities"><MiniAvatar variant="about" /></button>
        <span class="about-mini-ground" aria-hidden="true"></span>
        <span class="about-mini-caption">Click Mini to say hello</span>
      </div>
      <div class="about-mini-intro">
        <span class="case-study-kicker">THE PERSON BEHIND MINI’S WORLD</span>
        <h2>Min Kim</h2>
        <p class="about-mini-role">{aboutData.title}</p>
        <div class="prose-content">{aboutData.bio.split('\n\n').map(p => <p>{p}</p>)}</div>
        <a class="about-mini-email" href="mailto:aqeoon@gmail.com">Say hi · aqeoon@gmail.com ↗</a>
        <nav class="about-mini-paths" aria-label="Explore Min’s work and world"><a href="/projects">Explore my work →</a><a href="/game/mini-world">Visit Mini’s world →</a><a href="/support">Buy me a coffee ♡</a></nav>
      </div>
    </header>

    <h2 style="font-family: var(--font-serif); font-size: var(--step-2); margin-bottom: var(--space-s); font-weight: 500;">
      Design Principles
    </h2>
    <div class="principles-list">
      {aboutData.principles.map(item => (
        <div class="principle-item">
          <h3 class="principle-title">{item.title}</h3>
          <p class="principle-desc">{item.desc}</p>
        </div>
      ))}
    </div>

    <section class="about-projects">
      <div class="about-projects-heading">
        <div>
          <h2>Project details</h2>
          <p>Selected work, with the context and outcomes behind each project.</p>
        </div>
        <a href="/projects">View work summary →</a>
      </div>
      <a class="about-archive-invite" href="/work"><span aria-hidden="true">⚿</span><div><strong>Explore my project archive</strong><p>Enter the shared password once to browse every experience and open the full story behind each project.</p></div><span aria-hidden="true">→</span></a>
    </section>
  </div>
</Layout>
