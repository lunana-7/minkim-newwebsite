---
import Layout from '../layouts/Layout.astro';
import { aboutData } from '../posts.js';
---

<Layout title="About | Min Kim" activeNav="about">
  <div>
    <h1 class="page-title">About</h1>
    <p class="page-lead">{aboutData.title}</p>
    
    <div class="prose-content" style="margin-bottom: var(--space-xl);">
      {aboutData.bio.split('\n\n').map(p => <p>{p}</p>)}
      <p>Reach me at <a href="mailto:aqeoon@gmail.com">aqeoon@gmail.com</a>.</p>
    </div>

    <h2 style="font-family: var(--font-serif); font-size: var(--step-2); margin-bottom: var(--space-s); font-weight: 500;">
      Design Principles
    </h2>
    <div class="principles-list">
      {aboutData.principles.map(item => (
        <div class="principle-item">
          <h3 class="principle-title">{item.title}</h3>
          <p class="principle-desc">{item.desc}</p>
        </div>
      ))}
    </div>

    <section class="about-projects">
      <div class="about-projects-heading">
        <div>
          <h2>Project details</h2>
          <p>Selected work, with the context and outcomes behind each project.</p>
        </div>
        <a href="/projects">View work summary →</a>
      </div>
      <a class="about-archive-invite" href="/work"><span aria-hidden="true">⚿</span><div><strong>Explore my project archive</strong><p>Enter the shared password once to browse every experience and open the full story behind each project.</p></div><span aria-hidden="true">→</span></a>
    </section>
  </div>
</Layout>
