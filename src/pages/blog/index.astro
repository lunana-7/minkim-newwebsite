---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContentSearch from '../../components/ContentSearch.astro';
import { renderBanner } from '../../banners.js';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = ['all', ...new Set(sortedPosts.flatMap(p => p.data.tags))];

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const day = date.getUTCDate();
  let ordinal = "th";
  if (day === 1 || day === 21 || day === 31) ordinal = "st";
  else if (day === 2 || day === 22) ordinal = "nd";
  else if (day === 3 || day === 23) ordinal = "rd";

  const month = date.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
  const year = date.getUTCFullYear();
  return `${month} ${day}${ordinal}, ${year}`;
}
---

<Layout title="Blog | Min Kim" activeNav="blog">
  <div>
    <header class="blog-intro"><span class="case-study-kicker">Notes from Min’s World</span><h1 class="page-title">Blog</h1><p class="page-lead">Thoughts on AI governance, agent identity, and making things with care.</p></header>
    <ContentSearch initialType="Blog" />
    <!-- Tag Filters Bar -->
    <div class="filter-bar">
      {allTags.map(tag => (
        <button class={`filter-btn ${tag === 'all' ? 'active' : ''}`} data-filter={tag}>
          {tag === 'all' ? 'All Entries' : `#${tag}`}
        </button>
      ))}
    </div>

    <!-- Posts Listing -->
    <ul class="posts-list" id="posts-list">
      {sortedPosts.map(post => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const slugTitle = slug
          .split(/[-_]/)
          .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(' ');
        const displayTitle = (post.data.title && post.data.title !== 'Untitled Reflection')
          ? post.data.title
          : slugTitle;
        return (
          <li class="post-card" data-tags={post.data.tags.join(',')}>
            <a href={`/blog/${slug}`} class="post-thumb-link" aria-label={`Read ${displayTitle}`}>
              {post.data.coverImage ? <img class="post-pixel-cover" src={post.data.coverThumbnail || post.data.coverImage} alt={post.data.coverAlt || ''} width="480" height="270" loading="lazy" /> : <div class="post-thumb-svg" set:html={renderBanner(post.data.bannerType, false)} />}
            </a>
            <div class="post-card-info">
              <a href={`/blog/${slug}`} class="post-card-title">{displayTitle}</a>
              <div class="post-card-meta">
                <span class="author-chip">
                  <img src="/favicon-mini.png?v=unity-1" alt="Min Kim" class="author-avatar" />
                  <span>Min Kim</span>
                </span>
                <span class="meta-dot">·</span>
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                <span class="meta-dot">·</span>
                <span>{post.data.readingTime}</span>
              </div>
              <p class="post-card-excerpt">{post.data.excerpt}</p>
              <div class="post-card-tags">
                {post.data.tags.map((t: string) => (
                  <button class="post-tag-btn" data-tag-filter={t}>#{t}</button>
                ))}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>

  <style>
    .post-tag-btn {
      background: none;
      border: none;
      color: var(--muted-foreground);
      opacity: 0.8;
      font-size: 0.8rem;
      cursor: pointer;
      padding: 0;
      font-family: var(--font-sans);
    }
    .post-tag-btn:hover {
      color: var(--foreground);
      opacity: 1;
    }
  </style>

  <script is:inline>
    // Client-side instant tag filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const postCards = document.querySelectorAll('.post-card');

    function filterBy(tag) {
      filterButtons.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === tag);
      });

      postCards.forEach(card => {
        const cardTags = (card.dataset.tags || '').split(',');
        if (tag === 'all' || cardTags.includes(tag)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => filterBy(btn.dataset.filter));
    });

    document.querySelectorAll('.post-tag-btn').forEach(btn => {
      btn.addEventListener('click', () => filterBy(btn.dataset.tagFilter));
    });
  </script>
</Layout>
