---
export const prerender = false;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow, noarchive"/><title>Resume · Min Kim</title></head>
<body>
 <header><a class="name" href="/study/handshake-ai">Min Kim</a><span>Resume</span><nav><a href="/study/handshake-ai">Back to profile</a><a class="download" href="/documents/Resume_Minkim.pdf" download>Download PDF ↓</a></nav></header>
 <main><iframe src="/documents/Resume_Minkim.pdf" title="Min Kim’s resume"><p><a href="/documents/Resume_Minkim.pdf">View resume PDF</a></p></iframe></main>
 <style is:global>
 *{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;color:#14151a;background:#f5f8f8}header{min-height:80px;padding:18px 32px;display:flex;align-items:center;gap:24px;background:linear-gradient(100deg,#d7f9fc,#e4f8c5)}a{color:inherit;text-decoration:none}.name{font-size:24px;font-weight:600}header>span{border-left:1px solid #14151a30;padding-left:24px;font-size:16px}nav{display:flex;align-items:center;gap:24px;margin-left:auto;font-size:14px}.download{padding:12px 16px;border-radius:12px;background:#14151a;color:white}main{height:calc(100dvh - 80px);padding:16px}iframe{display:block;width:100%;height:100%;border:0;border-radius:8px;background:white}a:focus-visible{outline:2px solid #18889a;outline-offset:4px}@media(max-width:600px){header{padding:14px 16px;gap:12px;flex-wrap:wrap}header>span{padding-left:12px}nav{gap:14px}main{height:calc(100dvh - 115px);padding:8px}.download{padding:10px}}
 </style>
</body></html>
