---
import Layout from '../layouts/Layout.astro';
import { experiences, projectCatalog } from '../projects.js';
import ProjectGate from '../components/ProjectGate.astro';
import { hasProjectAccess, projectReturnPath, PRIVATE_PROJECT_HEADERS } from '../lib/project-access.js';
export const prerender = false;
const unlocked = hasProjectAccess(Astro.request);
const next = projectReturnPath(Astro.url.searchParams.get('next'));
for (const [name, value] of Object.entries(PRIVATE_PROJECT_HEADERS)) Astro.response.headers.set(name, value);
---

<Layout title="Projects | Min Kim" activeNav="work" description="Explore Min Kim's projects by experience: KRAFTON, Pacvue, Memoria, research, and community work.">
  {unlocked ? <Fragment>
  <div class="archive-access-bar"><span>✓ Project archive unlocked</span><button id="lock-project-archive" type="button">Lock archive</button></div>
  <header class="portfolio-intro" id="top">
    <span class="case-study-kicker">A portfolio of systems, research & ideas</span>
    <h1 class="page-title">Projects</h1>
    <p class="page-lead">From governing enterprise AI to building products and studying human–AI collaboration. Explore the overview, scroll through each experience, and open a project for the full story.</p>
    <div class="portfolio-stats"><span><strong>{projectCatalog.length}</strong> individual projects</span><span><strong>{experiences.length}</strong> experiences</span></div>
  </header>

  <nav class="experience-index" aria-label="Browse projects by experience">
    {experiences.map(experience => <a href={`#${experience.id}`}>{experience.name}<span>{projectCatalog.filter(project => project.experience === experience.id).length}</span></a>)}
  </nav>

  <div class="experience-groups">
    {experiences.map((experience, index) => {
      const projects = projectCatalog.filter(project => project.experience === experience.id);
      return <section class="experience-group" id={experience.id} aria-labelledby={`heading-${experience.id}`}>
        <header class="experience-heading">
          <span class="experience-number">{String(index + 1).padStart(2, '0')}</span>
          <div><p class="experience-type">{experience.type}</p><h2 id={`heading-${experience.id}`}>{experience.name}</h2><p class="experience-period">{experience.period} · {experience.role}</p></div>
        </header>
        <p class="experience-summary">{experience.summary}</p>
        <div class="experience-project-list">
          {projects.map(project => <a class="experience-project" href={`/projects/${project.slug}`}>
            <div class="experience-project-top"><span class="project-tag">{project.tag}</span><span class="project-date">{project.year}</span></div>
            <h3>{project.title}</h3><p>{project.description}</p>
            <span class="project-open">View project <span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
        <a class="back-to-experiences" href="#top">Back to experiences ↑</a>
      </section>;
    })}
  </div>
  </Fragment> : <ProjectGate next={next} />}
  <script>
    document.getElementById('lock-project-archive')?.addEventListener('click', async event => {
      const button = event.currentTarget; button.disabled = true;
      try {
        const response = await fetch('/api/projects/access', { method: 'DELETE' });
        if (response.ok) window.location.assign('/work');
        else button.textContent = 'Try locking again';
      } catch { button.textContent = 'Try locking again'; }
      finally { button.disabled = false; }
    });
  </script>
</Layout>
