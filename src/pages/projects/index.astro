---
import Layout from '../../layouts/Layout.astro';
import { workRegions } from '../../public-projects.js';
import { experienceMapLocations } from '../../experience-map.js';
---
<Layout title="Projects | Min Kim" activeNav="projects" description="Explore a public summary of Min Kim’s work in AI governance, product, research and community.">
  <header class="work-map-intro">
    <span class="case-study-kicker">MIN’S WORK WORLD</span>
    <h1 class="page-title">Projects</h1>
    <p class="page-lead">A little map of the work I’ve done. Follow the paths and select an experience to explore my role, focus and contributions.</p>
    <div class="work-map-progress"><span aria-hidden="true">✦</span><span id="work-map-progress">10 destinations to explore</span><button id="work-map-reset" type="button" hidden>Reset exploration</button></div>
  </header>
  <section class="experience-atlas-section" id="experience-map" aria-labelledby="experience-map-title">
    <div class="work-map-heading"><h2 id="experience-map-title">My experience world</h2><span>Choose an icon to explore ↓</span></div>
    <div class="experience-atlas" role="group" aria-label="Interactive map of Min’s ten experiences">
      <img class="experience-atlas-image" src="/experience-map/world.webp" width="1536" height="1152" alt="A dreamy pixel world with paths connecting a castle, harbor, workshops, observatory, village, guild, library, garden and camp." fetchpriority="high" />
      {workRegions.map(region=>{const location=experienceMapLocations[region.id];return <button class="experience-map-marker" type="button" data-work-region={region.id} data-map-x={location.x} data-map-y={location.y} aria-controls={`region-${region.id}`} aria-pressed="false" aria-label={`Explore ${region.name}: ${region.role}`} style={`--marker-x:${location.x}%;--marker-y:${location.y}%`}>
        <span class="experience-map-icon"><img src={location.icon} width="96" height="96" alt="" /><span class="work-map-visited" aria-label="Explored" hidden>✓</span></span>
        <strong>{location.label}</strong>
      </button>;})}
    </div>
    <p class="experience-atlas-hint">Every stop represents an experience. Select a location for my role, focus and contributions.</p>
    <details class="experience-map-index"><summary>Experience index</summary><nav aria-label="Experience text index">{workRegions.map(region=><a href={`#${region.id}`} data-experience-jump={region.id}>{region.name}</a>)}</nav></details>
  </section>
  <div class="work-region-panels">
    {workRegions.map(region => <section id={`region-${region.id}`} class="work-region-panel" data-work-panel={region.id} aria-labelledby={`title-${region.id}`}>
      <header><span class="work-region-icon work-region-art" aria-hidden="true"><img src={experienceMapLocations[region.id].icon} width="64" height="64" alt="" /></span><div><p class="case-study-kicker">{region.place}</p><h2 id={`title-${region.id}`} tabindex="-1">{region.name}</h2><p>{region.role} · {region.period}</p></div></header>
      <p class="work-region-summary">{region.summary}</p>
      <h3>What I worked on</h3><ul>{region.work.map(item => <li>{item}</li>)}</ul>
      <div class="work-region-skills" aria-label="Areas of focus">{region.skills.map(skill => <span>{skill}</span>)}</div>
      <div class="work-region-next"><a href="#experience-map">← Back to the experience map</a><a href="/about">Meet Min →</a></div>
    </section>)}
  </div>
  <script>
    const nodes = Array.from(document.querySelectorAll('[data-work-region]'));
    const panels = Array.from(document.querySelectorAll('[data-work-panel]'));
    const key = 'min-work-map-explored';
    let visited = new Set();
    try { const saved = JSON.parse(localStorage.getItem(key) || '[]'); if (Array.isArray(saved)) visited = new Set(saved.filter(id => nodes.some(node => node.dataset.workRegion === id))); } catch {}
    function updateProgress() {
      document.getElementById('work-map-progress').textContent = `${visited.size} / ${nodes.length} destinations explored${visited.size === nodes.length ? ' · Map complete! ✦' : ''}`;
      document.getElementById('work-map-reset').hidden = !visited.size;
      nodes.forEach(node => { node.querySelector('.work-map-visited').hidden = !visited.has(node.dataset.workRegion); });
      try { localStorage.setItem(key, JSON.stringify([...visited])); } catch {}
    }
    function selectRegion(id, focus = false) {
      nodes.forEach(node => node.setAttribute('aria-pressed', String(node.dataset.workRegion === id)));
      panels.forEach(panel => { panel.hidden = panel.dataset.workPanel !== id; });
      if (focus) {
        visited.add(id); updateProgress();
        history.replaceState(null, '', `#${id}`);
        const heading = document.querySelector(`[data-work-panel="${id}"] h2`);
        heading.focus({ preventScroll:true });
        heading.closest('section').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block:'start' });
      }
    }
    nodes.forEach(node => node.addEventListener('click', () => selectRegion(node.dataset.workRegion, true)));
    document.querySelector('.experience-atlas').addEventListener('click',event=>{if(event.target.closest('[data-work-region]'))return;const rect=event.currentTarget.getBoundingClientRect(),x=(event.clientX-rect.left)/rect.width*100,y=(event.clientY-rect.top)/rect.height*100;const nearest=nodes.reduce((best,node)=>{const distance=Math.hypot(Number(node.dataset.mapX)-x,Number(node.dataset.mapY)-y);return distance<best.distance?{node,distance}:best;},{node:null,distance:Infinity});if(nearest.distance<19)selectRegion(nearest.node.dataset.workRegion,true);});
    document.querySelectorAll('[data-experience-jump]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();selectRegion(link.dataset.experienceJump,true);}));
    const initial = location.hash.slice(1);
    selectRegion(nodes.some(node => node.dataset.workRegion === initial) ? initial : nodes[0].dataset.workRegion);
    updateProgress();
    document.getElementById('work-map-reset').addEventListener('click', () => { visited.clear(); updateProgress(); });
    window.addEventListener('hashchange', () => { const id = location.hash.slice(1); if (nodes.some(node => node.dataset.workRegion === id)) selectRegion(id); });
  </script>
</Layout>
