---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { renderBanner } from '../banners.js';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const day = date.getUTCDate();
  let ordinal = "th";
  if (day === 1 || day === 21 || day === 31) ordinal = "st";
  else if (day === 2 || day === 22) ordinal = "nd";
  else if (day === 3 || day === 23) ordinal = "rd";

  const month = date.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
  const year = date.getUTCFullYear();
  return `${month} ${day}${ordinal}, ${year}`;
}
---

<Layout title="Min Kim — AI Governance Analyst" description="Min Kim is an AI Governance Analyst specializing in agentic AI, enterprise governance, and practical AI deployment." activeNav="blog">
  <div class="home-world">
    <!-- Warm Editorial Bio Header -->
    <header class="home-hero">
      <div class="home-hero-copy">
      <span class="home-world-label"><i></i> MIN'S WORLD · EST. 2026</span>
      <h1 class="page-title" style="margin-bottom: 0.4rem;">Hello, I'm Min <span class="hero-sparkle">✦</span></h1>
      <p class="home-headline">
        AI Governance Analyst specializing in agentic AI.
      </p>
      <p class="home-intro">
        I help firms govern AI agents safely and efficiently to create 10× business value. I write about AI strategy, governance, and the systems that make adoption work.
      </p>
      <div class="home-actions"><a class="home-game-link" href="/game"><span aria-hidden="true">▶</span> Enter Min's World</a><a class="home-project-link" href="/work">Explore projects →</a></div>
      </div>
      <div class="home-mascot" aria-hidden="true"><span class="mascot-glow"></span><img src="/pixel-min.png" alt="" /><span class="mascot-star star-a">✦</span><span class="mascot-star star-b">✧</span></div>
    </header>

    <div class="home-section-title">
      <h2 style="font-family: var(--font-serif); font-size: var(--step-1); font-weight: 500;">Recent Writing</h2>
      <a href="/blog">View all entries →</a>
    </div>

    <!-- Posts Listing -->
    <ul class="posts-list">
      {sortedPosts.map(post => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const slugTitle = slug
          .split(/[-_]/)
          .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(' ');
        const displayTitle = (post.data.title && post.data.title !== 'Untitled Reflection')
          ? post.data.title
          : slugTitle;
        return (
          <li class="post-card">
            <a href={`/blog/${slug}`} class="post-thumb-link" aria-label={`Read ${displayTitle}`}>
              <div class="post-thumb-svg" set:html={renderBanner(post.data.bannerType, false)} />
            </a>
            <div class="post-card-info">
              <a href={`/blog/${slug}`} class="post-card-title">{displayTitle}</a>
              <div class="post-card-meta">
                <span class="author-chip">
                  <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Min Kim" class="author-avatar" />
                  <span>Min Kim</span>
                </span>
                <span class="meta-dot">·</span>
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                <span class="meta-dot">·</span>
                <span>{post.data.readingTime}</span>
              </div>
              <p class="post-card-excerpt">{post.data.excerpt}</p>
              <div class="post-card-tags">
                {post.data.tags.map((t: string) => (
                  <span style="color: var(--muted-foreground); opacity: 0.8; font-size: 0.8rem;">#{t}</span>
                ))}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</Layout>
