---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { renderBanner } from '../banners.js';
import '../pet-care.css';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const day = date.getUTCDate();
  let ordinal = "th";
  if (day === 1 || day === 21 || day === 31) ordinal = "st";
  else if (day === 2 || day === 22) ordinal = "nd";
  else if (day === 3 || day === 23) ordinal = "rd";

  const month = date.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
  const year = date.getUTCFullYear();
  return `${month} ${day}${ordinal}, ${year}`;
}
---

<Layout title="Min Kim — AI Governance Analyst" description="Research and practical guidance on agentic AI governance, enterprise AI, identity, safety, and accountable deployment by Min Kim." activeNav="home">
  <div class="home-world">
    <!-- Warm Editorial Bio Header -->
    <header class="home-hero">
      <div class="home-hero-lights" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="home-hero-copy">
      <span class="home-world-label"><i></i> MIN'S WORLD · EST. 2026</span>
      <h1 class="page-title" style="margin-bottom: 0.4rem;">Hello, I'm Min <span class="hero-sparkle">✦</span></h1>
      <p class="home-headline">
        AI Governance Analyst specializing in agentic AI.
      </p>
      <p class="home-intro">
        I help firms govern AI agents safely and efficiently to create 10× business value. I write about AI strategy, governance, and the systems that make adoption work.
      </p>
      <div class="home-actions"><a class="home-game-link" href="/game/mini-world"><span aria-hidden="true">▶</span> Enter Mini World</a><a class="home-project-link" href="/projects">Explore projects →</a><a class="home-room-link" href="/room">Visit my room & guestbook ♡</a></div>
      </div>
      <div class="home-mascot home-planning-mascot"><button class="home-avatar-trigger" type="button" data-min-open-menu aria-label="Meet Mini and open her activities"><picture><source media="(prefers-reduced-motion: reduce)" srcset="/mini/home/planning-still.png" /><img class="home-planning-gif" src="/mini/home/planning.gif" width="384" height="384" alt="Original Mini draws ideas on a board, organizes them into a flowchart, and erases the board to begin again." fetchpriority="high" /></picture></button><span class="home-planning-caption">A little sketch. A clearer structure. A fresh start.</span></div>
    </header>

    <a class="home-pet-invite" href="/pet"><img src="/game-art/items/pet-dog-cream-0.png" width="68" height="68" alt="" loading="lazy" /><span><small>A LITTLE FRIEND TO CARE FOR</small><strong>Visit the Pet Garden</strong><span>Feed, play, rest, and grow together. ♡</span></span><span class="home-pet-arrow" aria-hidden="true">→</span></a>

    <div class="home-section-title">
      <h2 style="font-family: var(--font-pixel); font-size: var(--step-2); font-weight: 500;">Recent Blog posts</h2>
      <a href="/blog">View Blog →</a>
    </div>

    <!-- Posts Listing -->
    <ul class="posts-list">
      {sortedPosts.map(post => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const slugTitle = slug
          .split(/[-_]/)
          .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(' ');
        const displayTitle = (post.data.title && post.data.title !== 'Untitled Reflection')
          ? post.data.title
          : slugTitle;
        return (
          <li class="post-card">
            <a href={`/blog/${slug}`} class="post-thumb-link" aria-label={`Read ${displayTitle}`}>
              {post.data.coverImage ? <img class="post-pixel-cover" src={post.data.coverThumbnail || post.data.coverImage} alt={post.data.coverAlt || ''} width="480" height="270" loading="lazy" /> : <div class="post-thumb-svg" set:html={renderBanner(post.data.bannerType, false)} />}
            </a>
            <div class="post-card-info">
              <a href={`/blog/${slug}`} class="post-card-title">{displayTitle}</a>
              <div class="post-card-meta">
                <span class="author-chip">
                  <img src="/favicon-mini.png?v=unity-1" alt="Min Kim" class="author-avatar" />
                  <span>Min Kim</span>
                </span>
                <span class="meta-dot">·</span>
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                <span class="meta-dot">·</span>
                <span>{post.data.readingTime}</span>
              </div>
              <p class="post-card-excerpt">{post.data.excerpt}</p>
              <div class="post-card-tags">
                {post.data.tags.map((t: string) => (
                  <span style="color: var(--muted-foreground); opacity: 0.8; font-size: 0.8rem;">#{t}</span>
                ))}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</Layout>
