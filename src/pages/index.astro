---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { renderBanner } from '../banners.js';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const day = date.getUTCDate();
  let ordinal = "th";
  if (day === 1 || day === 21 || day === 31) ordinal = "st";
  else if (day === 2 || day === 22) ordinal = "nd";
  else if (day === 3 || day === 23) ordinal = "rd";

  const month = date.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
  const year = date.getUTCFullYear();
  return `${month} ${day}${ordinal}, ${year}`;
}
---

<Layout title="Min Kim — Design Engineer & Writer" activeNav="blog">
  <div>
    <!-- Warm Editorial Bio Header -->
    <header style="margin-bottom: var(--space-xl); padding-bottom: var(--space-l); border-bottom: 1px solid var(--border);">
      <h1 class="page-title" style="margin-bottom: 0.4rem;">Min Kim</h1>
      <p style="font-size: var(--step-1); color: var(--foreground-l3); line-height: 1.5; margin-bottom: 0.8rem;">
        Design engineer exploring typographic craft, quiet digital systems, and Japanese editorial aesthetics.
      </p>
      <p style="font-size: var(--step--1); color: var(--muted-foreground); line-height: 1.6; max-width: 36rem;">
        Welcome to my personal reading room. Every essay is written in plain Markdown, set in Shippori Mincho serif, and calibrated for focused contemplation on unbleached digital parchment.
      </p>
    </header>

    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-m);">
      <h2 style="font-family: var(--font-serif); font-size: var(--step-1); font-weight: 500;">Recent Writing</h2>
      <a href="/blog" style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--accent-vermilion); text-decoration: none;">View all entries →</a>
    </div>

    <!-- Posts Listing -->
    <ul class="posts-list">
      {sortedPosts.map(post => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <li class="post-card">
            <a href={`/blog/${slug}`} class="post-thumb-link" aria-label={`Read ${post.data.title}`}>
              <div class="post-thumb-svg" set:html={renderBanner(post.data.bannerType, false)} />
            </a>
            <div class="post-card-info">
              <a href={`/blog/${slug}`} class="post-card-title">{post.data.title}</a>
              <div class="post-card-meta">
                <span class="author-chip">
                  <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Min Kim" class="author-avatar" />
                  <span>Min Kim</span>
                </span>
                <span class="meta-dot">·</span>
                <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                <span class="meta-dot">·</span>
                <span>{post.data.readingTime}</span>
              </div>
              <p class="post-card-excerpt">{post.data.excerpt}</p>
              <div class="post-card-tags">
                {post.data.tags.map((t: string) => (
                  <span style="color: var(--muted-foreground); opacity: 0.8; font-size: 0.8rem;">#{t}</span>
                ))}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</Layout>
