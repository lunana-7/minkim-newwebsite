---
import Layout from '../../layouts/Layout.astro';
import { wikiEntries } from '../../wiki.js';
export const prerender = true;
const categories = ['All concepts', ...new Set(wikiEntries.map(entry => entry.category))];
---
<Layout title="Wiki | Min Kim" activeNav="wiki" description="A practical reference for AI governance, agent identity, runtime governance, and policy information points.">
  <header class="wiki-intro">
    <span class="case-study-kicker">Min’s field notes</span>
    <h1 class="page-title">Wiki</h1>
    <p class="page-lead">A growing reference for the ideas behind safe, useful AI agents. Start with a definition, follow the connections, and see how it works in practice.</p>
    <p class="wiki-editor-note">Definitions include source notes. Practical patterns and examples are Min’s synthesis. Last reviewed <time datetime="2026-10-11">October 11, 2026</time>.</p>
  </header>
  <section class="wiki-reading-path" aria-labelledby="wiki-path-title">
    <h2 id="wiki-path-title">A useful place to start</h2>
    <p>Follow the path from organization-wide oversight to a single action.</p>
    <ol>{['ai-governance', 'agentic-ai-governance', 'agent-identity', 'runtime-governance', 'policy-information-point'].map(slug => <li><a href={`/wiki/${slug}`}>{wikiEntries.find(entry => entry.slug === slug).title}</a></li>)}</ol>
  </section>
  <section class="wiki-library" aria-labelledby="wiki-library-title">
    <div class="wiki-library-heading"><h2 id="wiki-library-title">Explore the concepts</h2><span id="wiki-result-count" role="status">5 concepts</span></div>
    <label class="wiki-search-label" for="wiki-search">Find a definition</label>
    <input class="wiki-search-input" id="wiki-search" type="search" placeholder="Search identity, permissions, PIP…" autocomplete="off" />
    <div class="filter-bar wiki-filters" role="group" aria-label="Filter concepts by category">{categories.map((category, i) => <button type="button" class={`filter-btn ${i === 0 ? 'active' : ''}`} data-wiki-category={category} aria-pressed={i === 0 ? 'true' : 'false'}>{category}</button>)}</div>
    <div class="wiki-grid">{wikiEntries.map(entry => <a class="wiki-card" href={`/wiki/${entry.slug}`} data-wiki-entry data-category={entry.category} data-search={`${entry.title} ${entry.category} ${entry.summary} ${entry.definition} ${entry.slug === 'policy-information-point' ? 'PIP PDP PEP PAP attributes authorization' : ''}`.toLowerCase()}>
      <div class="wiki-card-top"><span class="wiki-glyph" aria-hidden="true">{entry.glyph}</span><span>{entry.category}</span></div>
      <h3>{entry.title}</h3><p>{entry.summary}</p><span class="wiki-card-link">Read the definition <span aria-hidden="true">→</span></span>
    </a>)}</div>
    <p id="wiki-empty" class="wiki-empty" hidden>No concepts match that search. Try “governance” or “identity”.</p>
  </section>
  <section class="wiki-connections" aria-labelledby="wiki-connections-title">
    <h2 id="wiki-connections-title">How the concepts connect</h2>
    <dl>{wikiEntries.map(entry => <div><dt><a href={`/wiki/${entry.slug}`}>{entry.title}</a></dt><dd>{entry.question}</dd></div>)}</dl>
  </section>
  <a class="wiki-blog-link" href="/blog">Read the Blog for longer discussions →</a>
  <script>
    let selectedCategory = 'All concepts';
    const search = document.getElementById('wiki-search');
    const cards = [...document.querySelectorAll('[data-wiki-entry]')];
    const filters = [...document.querySelectorAll('[data-wiki-category]')];
    function filterWiki() {
      const query = search.value.trim().toLowerCase(); let count = 0;
      cards.forEach(card => {
        const visible = (selectedCategory === 'All concepts' || card.dataset.category === selectedCategory) && card.dataset.search.includes(query);
        card.hidden = !visible; if (visible) count++;
      });
      document.getElementById('wiki-result-count').textContent = `${count} ${count === 1 ? 'concept' : 'concepts'}`;
      document.getElementById('wiki-empty').hidden = count > 0;
      filters.forEach(button => { const active = button.dataset.wikiCategory === selectedCategory; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
    }
    search.addEventListener('input', filterWiki);
    filters.forEach(button => button.addEventListener('click', () => { selectedCategory = button.dataset.wikiCategory; filterWiki(); }));
  </script>
</Layout>
