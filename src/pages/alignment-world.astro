---
import Layout from '../layouts/Layout.astro';
import { STORY, ALIGNMENT_VENUES } from '../lib/alignment-story.js';
---
<Layout title="Alignment World — The Lantern Protocol" activeNav="alignment-world" description="An original pixel story world about AI alignment, learning loops, governance and responsible innovation.">
 <a class="back-link game-collection-back" href="/game">← All games</a>
 <header class="alignment-intro"><span class="game-kicker">A NEW WORLD · STORY RPG</span><h1 class="page-title">{STORY.title}</h1><h2>{STORY.subtitle}</h2><p>{STORY.premise}</p></header>
 <section id="alignment-shell" class="alignment-shell" aria-label="Alignment World game">
  <header class="alignment-topbar"><div><strong>THE LANTERN PROTOCOL</strong><small id="alignment-engine">Explore · learn · restore the beacons</small></div><div><button type="button" id="alignment-login">Sign in with Google</button><button type="button" id="alignment-logout" hidden>Sign out</button><button type="button" id="alignment-fullscreen">Full screen ↗</button></div></header>
  <div class="alignment-hud"><span id="alignment-player">Visitor · enter to play</span><span id="alignment-beacons">0 / 6 trust beacons</span><span id="alignment-save">Story preview</span></div>
  <div class="alignment-stage"><canvas id="alignment-canvas" width="960" height="540" tabindex="0" aria-label="Pixel world of Lumen. Move with arrows or A and D, press Enter by a door or guide, and press Up at a portal."></canvas><p id="alignment-hint" class="alignment-hint" role="status">Walk to the school door and press Enter.</p><div id="alignment-login-gate" class="alignment-gate"><span>✦</span><h2>Become an Alignment Steward</h2><p>Enter Lumen, visit two schools and a company, talk with each guide, and restore six trust beacons.</p><button type="button" id="alignment-enter">Enter the world →</button><p id="alignment-account-status" role="status"></p></div>
   <section id="alignment-dialog" class="alignment-dialog" hidden aria-labelledby="alignment-term"><header><img id="alignment-portrait" alt="" width="108" height="108"/><div><span id="alignment-host"></span><h3 id="alignment-term"></h3></div><button type="button" id="alignment-dialog-close" aria-label="Close dialogue">×</button></header><div class="alignment-dialog-body"><p id="alignment-dialog-story" aria-live="polite"></p><p id="alignment-concept" hidden></p><h4 id="alignment-question" hidden></h4><div id="alignment-options" hidden></div><p id="alignment-feedback" role="status"></p><div class="alignment-dialog-footer"><a id="alignment-source" target="_blank" rel="noopener noreferrer" hidden>Read the source ↗</a><button type="button" id="alignment-dialog-next">Next →</button></div><p id="alignment-career" hidden></p></div></section>
  </div>
  <div class="alignment-controls"><button type="button" data-alignment-move="-1" aria-label="Move left">←</button><button type="button" data-alignment-move="1" aria-label="Move right">→</button><button type="button" id="alignment-jump">Jump ↑</button><button type="button" id="alignment-talk">Enter / interact</button><span id="alignment-presence">Shared presence connects after sign-in.</span></div>
  <nav id="alignment-regions" aria-label="Story regions">{STORY.chapters.map((c,i)=><button type="button" data-alignment-region={i}>{i+1}. {c.name}</button>)}</nav>
 </section>
 <section class="alignment-campus-guide"><h2>Three places to learn</h2><div>{Object.entries(ALIGNMENT_VENUES).map(([id,venue])=><article><img src={venue.building} alt="" loading="lazy"/><div><span>{id==='company'?'ENTERPRISE':'ACADEMY'}</span><h3>{venue.name}</h3><p>{venue.focus}</p></div></article>)}</div></section>
 <details class="alignment-campaign"><summary>Chapters & primary sources</summary><p>This story is fictional. Singularity and intelligence-explosion scenarios are hypotheses, not forecasts. The lessons link to NIST and OWASP primary material.</p><div>{STORY.chapters.map((c,i)=><article><span>CHAPTER {i+1}</span><h3>{c.name}</h3><p>{c.term}</p><a href={c.source} target="_blank" rel="noopener noreferrer">Primary reading ↗</a></article>)}</div></details>
</Layout>
<script>import { initAlignmentWorld } from '../lib/alignment-world.js';initAlignmentWorld();</script>
