---
import Layout from '../layouts/Layout.astro';
import { STORY } from '../lib/alignment-story.js';
---
<Layout title="Alignment World — The Lantern Protocol" activeNav="alignment-world" description="An original pixel story world about AI alignment, learning loops, governance and responsible innovation.">
 <header class="alignment-intro"><span class="game-kicker">A NEW WORLD · STORY RPG</span><h1 class="page-title">{STORY.title}</h1><h2>{STORY.subtitle}</h2><p>{STORY.premise}</p></header>
 <section id="alignment-shell" class="alignment-shell" aria-label="Alignment World game">
  <header class="alignment-topbar"><div><strong>THE LANTERN PROTOCOL</strong><small id="alignment-engine">Browser prototype · Unity build pending</small></div><div><button type="button" id="alignment-login">Sign in with Google</button><button type="button" id="alignment-logout" hidden>Sign out</button><button type="button" id="alignment-fullscreen">Full screen ↗</button></div></header>
  <div class="alignment-hud"><span id="alignment-player">Visitor · enter to play</span><span id="alignment-beacons">0 / 6 trust beacons</span><span id="alignment-save">Story preview</span></div>
  <div class="alignment-stage"><canvas id="alignment-canvas" width="960" height="540" tabindex="0" aria-label="Pixel world of Lumen. Move with arrow keys or A and D, jump with Space, and talk with Enter."></canvas><div id="alignment-login-gate" class="alignment-gate"><span>✦</span><h2>Become an Alignment Steward</h2><p>Enter Lumen, meet your guides and restore six trust beacons. Guest progress saves in this browser.</p><button type="button" id="alignment-enter">Enter the world →</button><p id="alignment-account-status" role="status"></p></div><div id="alignment-unity-host" hidden></div></div>
  <div class="alignment-controls"><button type="button" data-alignment-move="-1" aria-label="Move left">←</button><button type="button" data-alignment-move="1" aria-label="Move right">→</button><button type="button" id="alignment-jump">Jump ↑</button><button type="button" id="alignment-talk">Talk / Enter</button><span id="alignment-presence">Shared presence connects after sign-in.</span></div>
  <nav id="alignment-regions" aria-label="Story regions">{STORY.chapters.map((c,i)=><button type="button" data-alignment-region={i}>{i+1}. {c.name}</button>)}</nav>
  <section id="alignment-dialog" class="alignment-dialog" hidden><header><img id="alignment-portrait" alt="" width="54" height="80"/><div><span id="alignment-host"></span><h3 id="alignment-term"></h3></div><button type="button" id="alignment-dialog-close" aria-label="Close dialogue">×</button></header><p id="alignment-dialog-story"></p><p id="alignment-concept"></p><h4 id="alignment-question"></h4><div id="alignment-options"></div><p id="alignment-feedback" role="status"></p><a id="alignment-source" target="_blank" rel="noopener noreferrer">Read the source ↗</a><p id="alignment-career"></p></section>
 </section>
 <section class="alignment-campaign"><h2>Six beacons. One shared future.</h2><p>This story is fictional. Singularity and intelligence-explosion scenarios are hypotheses, not forecasts. Research findings and working governance definitions are identified inside the quests.</p><div>{STORY.chapters.map((c,i)=><article><span>CHAPTER {i+1}</span><h3>{c.name}</h3><p>{c.story}</p><strong>{c.term}</strong><small>{c.career}</small><a href={c.source} target="_blank" rel="noopener noreferrer">Reading ↗</a></article>)}</div></section>
 <p class="alignment-build-note">Unity project source is prepared. The current scene is a browser prototype; the Unity Web build is not compiled yet. Guest gameplay is available now with browser saves. Google cloud saves and shared presence require the pending Firebase setup.</p>
 <a href="/alignment-world/unity-project.zip" download>Download Unity project source →</a>
</Layout>
<script>import { initAlignmentWorld } from '../lib/alignment-world.js';initAlignmentWorld();</script>
